# Copy to .env and fill in. `docker compose up -d` reads it, and so does the
# app itself, through env_file. Keep it out of version control: it holds two
# GitLab tokens, one of them instance-admin.
#
# What each setting does: docs/configuration.md
# Where the tokens come from: docs/gitlab-setup.md

## Required ##################################################################

# Base URL of the GitLab instance to mirror.
GITLAB_URL=https://gitlab.example.com

# Read-only token (read_api scope), used for all data fetching.
GITLAB_READ_TOKEN=

# Write token (api scope) belonging to the instance-admin service account.
# Used only to manage webhooks and achievements.
GITLAB_WRITE_TOKEN=

# Full path of the GitLab namespace that owns the achievement definitions,
# e.g. "achievements" or "platform/achievements".
ACHIEVEMENTS_NAMESPACE=achievements

# Shared secret GitLab presents on every webhook delivery.
# Generate one with: openssl rand -hex 32
WEBHOOK_SECRET=

# Where GitLab reaches this app. It must resolve from the GitLab instance,
# with no trailing path: the webhook URL is built by appending to it.
PUBLIC_URL=https://achievements.example.com

# Connection string for the database below. The password must match
# POSTGRES_PASSWORD; it is spelled out twice because the app and PostgreSQL
# are configured independently.
DATABASE_DSN=postgres://achievements:CHANGEME@db:5432/achievements?sslmode=disable

## PostgreSQL ################################################################

POSTGRES_PASSWORD=CHANGEME
# Defaults matching the DSN above; change both together if you change these.
#POSTGRES_USER=achievements
#POSTGRES_DB=achievements

## Optional ##################################################################

# Container image tag. Pin it to a release rather than tracking latest.
#IMAGE_TAG=latest

# Host interface and port the app is published on. The default keeps it on
# localhost, for a reverse proxy in front to terminate TLS.
#LISTEN_ADDRESS=127.0.0.1
#LISTEN_PORT=8080

# debug, info, warn, error.
#LOG_LEVEL=info

# auto, group, or project. auto picks group hooks where the license allows.
#HOOK_SCOPE=auto
#HOOK_RATE=20

# auto, off, or force.
#BACKFILL=auto
# A date (2024-01-01) or a duration (720h); empty walks the full history.
#BACKFILL_SINCE=
#BACKFILL_RATE=5

# Periodic re-read of recent activity, healing webhook deliveries GitLab
# never managed to make. auto runs it in the app, shortly after startup and
# on the interval below; off leaves it to a scheduled
# `gitlab-achievements reconcile`. The lookback must exceed the interval, so
# consecutive passes overlap rather than abut.
#RECONCILE=auto
#RECONCILE_INTERVAL=24h
#RECONCILE_LOOKBACK=48h

# none, or gitlab to require a GitLab token on every API request.
#API_AUTH=none
#OAUTH_CLIENT_ID=
#OAUTH_CLIENT_SECRET=
