{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":assignAndReview(BoxBoxJason)",
    ":combinePatchMinorReleases",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":docker",
    ":enableRenovate",
    ":enableVulnerabilityAlertsWithAdditionalLabel(security)",
    ":gitSignOff",
    ":gomod",
    ":ignoreModulesAndTests",
    ":labels(deps,source::bot)",
    ":rebaseStalePrs",
    ":renovatePrefix",
    ":semanticCommits",
    ":semanticCommitScope(deps)",
    ":semanticCommitType(chore)",
    "group:all",
    "helpers:githubDigestChangelogs",
    "helpers:gitlabDigestChangelogs",
    "helpers:goXPackagesNameLink",
    "helpers:renovateChangelog",
    "mergeConfidence:all-badges",
    "security:openssf-scorecard",
    "workarounds:all"
  ],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "updateInternalDeps": true,
  "dependencyDashboardAutoclose": true,
  "dependencyDashboardLabels": [
    "deps",
    "source::bot"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "The chart's image is this repository's own build, versioned through Chart.yaml's appVersion. Renovate's digest pinning wrote '@sha256:...' into image.tag (#28), which renders an invalid image reference and an invalid version label.",
      "matchManagers": [
        "helm-values"
      ],
      "matchFileNames": [
        "chart/values.yaml"
      ],
      "matchPackageNames": [
        "ghcr.io/boxboxjason/gitlab-achievements"
      ],
      "enabled": false
    },
    {
      "description": "Major updates can break the build in ways CI doesn't catch, so they keep waiting for a human review.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "TypeScript 7 doesn't work with this project's toolchain yet; stay on 6.x. Drop this rule once it does.",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Go tool versions the Makefile installs on demand, each annotated with a '# renovate:' comment naming its datasource and module.",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Za-z0-9_]+ := (?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "The release .env.example pins for docker-compose, annotated the same way.",
      "managerFilePatterns": [
        "/^\\.env\\.example$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z0-9_]+=(?<currentValue>\\S+)"
      ]
    }
  ],
  "automerge": true
}
