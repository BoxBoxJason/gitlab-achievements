# Install as /etc/gitlab-achievements/gitlab-achievements.env, owned by
# root:root with mode 0600: systemd reads it before dropping privileges, so
# the service account never needs access to it.
#
# systemd's EnvironmentFile is not a shell script. Values are taken literally,
# there is no expansion, and quotes are only needed around a value with
# trailing whitespace.
#
# What each setting does: docs/configuration.md
# Where the tokens come from: docs/gitlab-setup.md

## Required ##################################################################

GITLAB_URL=https://gitlab.example.com

# Read-only token (read_api scope).
GITLAB_READ_TOKEN=

# Write token (api scope) belonging to the instance-admin service account.
GITLAB_WRITE_TOKEN=

# Full path of the namespace that owns the achievement definitions.
ACHIEVEMENTS_NAMESPACE=achievements

# Shared secret GitLab presents on every webhook delivery.
# Generate one with: openssl rand -hex 32
WEBHOOK_SECRET=

# Where GitLab reaches this app, with no trailing path.
PUBLIC_URL=https://achievements.example.com

# PostgreSQL, or sqlite:///var/lib/gitlab-achievements/data.db for a small
# single-host install (the unit's StateDirectory is that path's parent).
DATABASE_DSN=postgres://achievements:CHANGEME@localhost:5432/achievements?sslmode=require

## Optional ##################################################################

# Bind to localhost when a reverse proxy in front terminates TLS.
#LISTEN_ADDR=127.0.0.1:8080

#LOG_LEVEL=info

#HOOK_SCOPE=auto
#HOOK_RATE=20

#BACKFILL=auto
#BACKFILL_SINCE=
#BACKFILL_RATE=5

#API_AUTH=none
#OAUTH_CLIENT_ID=
#OAUTH_CLIENT_SECRET=
